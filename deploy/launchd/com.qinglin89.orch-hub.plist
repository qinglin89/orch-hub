<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- orch-hub launchd user agent template.

       orch-hub launchd deploy/update reads this file as the plist-structure
       template and replaces every REPLACE-... value before installing it.
       For manual recovery, replace placeholders with absolute paths/values
       (launchd does not expand ~), then install per docs/launchd.md.
       The installed file embeds ORCH_HUB_TOKEN: keep it chmod 600. -->
  <key>Label</key>
  <string>com.qinglin89.orch-hub</string>

  <!-- What launchd runs. deploy/update/setup replace this whole array, because
       its length depends on the runtime shape: an installed release is
       `<install-prefix>/current/orch-hub serve` (one executable, no console
       scripts), a source checkout is `<checkout>/.venv/bin/orch-hub-api`.
       For manual recovery, write the absolute program and its arguments as one
       <string> per element. -->
  <key>ProgramArguments</key>
  <array>
    <string>REPLACE-ORCH-HUB-PROGRAM</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- Required. With it unset the service fails closed: every protected
         route answers 503; only GET /api/health and the secret-free dashboard
         shell assets serve.
         Generate one: openssl rand -hex 32 -->
    <key>ORCH_HUB_TOKEN</key>
    <string>REPLACE-BEARER-TOKEN</string>

    <!-- Bind address/port. Keep 127.0.0.1 behind `tailscale serve`, or set
         the Mac's Tailscale IP (100.x.y.z) for a direct tailnet bind.
         Never a LAN or public interface. -->
    <key>ORCH_HUB_HOST</key>
    <string>REPLACE-ORCH-HUB-HOST</string>
    <key>ORCH_HUB_PORT</key>
    <string>REPLACE-ORCH-HUB-PORT</string>

    <!-- mandrel checkout that owns the managed-repo registry. -->
    <key>ORCH_HUB_MANDREL_PATH</key>
    <string>REPLACE-MANDREL-CHECKOUT</string>

    <!-- Hub-owned run dirs and audit history. -->
    <key>ORCH_HUB_DATA_DIR</key>
    <string>REPLACE-ORCH-HUB-DATA-DIR</string>

    <!-- Optional. Bark push endpoint (server + device key) for run-lifecycle
         and pending-question notifications; blank disables push. The device
         key is a secret, so keep the installed plist chmod 600. deploy/update
         read it from ORCH_HUB_BARK_URL in the environment (or preserve the
         value already installed). -->
    <key>ORCH_HUB_BARK_URL</key>
    <string>REPLACE-ORCH-HUB-BARK-URL</string>

    <!-- launchd agents get a minimal PATH. Readiness checks invoke `git`,
         and mandrel may need Homebrew-installed tooling. -->
    <key>PATH</key>
    <string>REPLACE-PATH</string>
  </dict>

  <!-- Start at login and restart on exit. `launchctl bootout` is the stop;
       a plain kill only makes launchd respawn the service. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- launchd creates these files but not their directory:
       mkdir -p ~/Library/Logs/orch-hub before bootstrapping.
       uvicorn sends access logs to stdout, lifecycle/errors to stderr. -->
  <key>StandardOutPath</key>
  <string>REPLACE-ORCH-HUB-LOG-DIR/orch-hub.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE-ORCH-HUB-LOG-DIR/orch-hub.err.log</string>
</dict>
</plist>
